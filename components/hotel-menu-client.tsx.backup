"use client"

import { useEffect, useMemo, useState } from "react"
import { apiFetch } from "@/lib/api-client"
import { cn, getImageUrl } from "@/lib/utils"
// Import new components
import { HeroSection } from "./restaurant/HeroSection"
import { StorySection } from "./restaurant/StorySection"
import { LocationSection } from "./restaurant/LocationSection"
import { ReservationSection } from "./restaurant/ReservationSection"
import { EventsSection } from "./restaurant/EventsSection"
import { MenuPreviewSection } from "./restaurant/MenuPreviewSection"
import { TestimonialsSection } from "./restaurant/TestimonialsSection"
import { FooterSection } from "./restaurant/FooterSection"

type Restaurant = {
  id: string
  name: string
  slug: string
  description?: string
  tagline?: string
  address?: string
  phone?: string
  logo_url?: string
  cover_url?: string
  is_published?: boolean
  cuisine_type?: string
  email?: string
  instagram_url?: string
  facebook_url?: string
  twitter_url?: string
  tiktok_url?: string
  website_url?: string
  opening_hours?: string
  rating?: number
  review_count?: number
  enableReservation?: boolean
  enable_reservation?: boolean
  reservation_enabled?: boolean
  events?: EventItem[]
  upcoming_events?: EventItem[]
  testimonials?: Testimonial[]
  popular_items?: MenuPreviewItem[]
  featured_items?: MenuPreviewItem[]
}

type EventItem = {
  id?: string
  title: string
  date: string
  description?: string
  image_url?: string
  href?: string
}

type Testimonial = {
  name: string
  text: string
  rating?: number
}

type MenuPreviewItem = {
  id: string
  name: string
  price: number
  currency?: string
  description?: string
  image_url?: string
}

type BestDish = {
  id: string
  name: string
  description: string
  price: number
  currency?: string
  image_url?: string
  rating: number
  tag: string
}

interface HotelMenuClientProps {
  hotelSlug: string
  initialData?: Restaurant
}

export default function HotelMenuClient({ hotelSlug, initialData }: HotelMenuClientProps) {
  const [hotel, setHotel] = useState<Restaurant | null>(initialData || null)
  const [loading, setLoading] = useState(!initialData)
  const [error, setError] = useState<string | null>(null)
  const [menuPreview, setMenuPreview] = useState<MenuPreviewItem[]>([])
  const [menuLoading, setMenuLoading] = useState(false)

  useEffect(() => {
    if (initialData) return

    const load = async () => {
      try {
        setLoading(true)
        const res = await apiFetch<any>(`/restaurants/${hotelSlug}`)
        setHotel(res?.data || res)
      } catch (err: any) {
        setError(err.message || "Failed to load restaurant details")
      } finally {
        setLoading(false)
      }
    }
    load()
  }, [hotelSlug, initialData])

  useEffect(() => {
    const loadMenuPreview = async () => {
      try {
        setMenuLoading(true)
        const res = await apiFetch<any>(`/restaurants/${hotelSlug}/categories`)
        const categories = Array.isArray(res) ? res : (res?.data || [])
        const items: MenuPreviewItem[] = []

        for (const category of categories.slice(0, 4)) {
          const itemsRes = await apiFetch<any>(`/restaurants/${hotelSlug}/categories/${category.id}/items`)
          const categoryItems = Array.isArray(itemsRes) ? itemsRes : (itemsRes?.data || [])
          for (const item of categoryItems) {
            items.push({
              id: String(item.id),
              name: item.name,
              price: Number(item.price || 0),
              currency: item.currency,
              description: item.description,
              image_url: item.image_url,
            })
            if (items.length >= 5) break
          }
          if (items.length >= 5) break
        }

        setMenuPreview(items)
      } catch (err) {
        console.error("Failed to load menu preview", err)
      } finally {
        setMenuLoading(false)
      }
    }

    loadMenuPreview()
  }, [hotelSlug])

  if (loading) {
    return (
      <div className="flex flex-col h-screen items-center justify-center bg-[#0c0c0c]">
        <motion.div
          initial={{ opacity: 0, y: 10 }}
          animate={{ opacity: 1, y: 0 }}
          className="flex flex-col items-center gap-4"
        >
          <div className="h-12 w-12 rounded-full border border-white/20 animate-spin border-t-white" />
          <p className="text-sm uppercase tracking-[0.4em] text-white/70">Loading experience</p>
        </motion.div>
      </div>
    )
  }

  const isPublished = hotel?.is_published === true || String(hotel?.is_published) === "true"

  if (error || !hotel || !isPublished) {
    return (
      <div className="flex h-screen flex-col items-center justify-center bg-background gap-8 p-6 text-center">
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          className="space-y-4"
        >
          <div className="mx-auto w-24 h-24 rounded-full bg-secondary flex items-center justify-center">
            <Utensils className="h-10 w-10 text-muted-foreground" />
          </div>
          <h1 className="text-4xl font-serif text-foreground">
            {!hotel || !isPublished ? "Closed For Refurbishment" : "Menu Not Found"}
          </h1>
          <p className="text-muted-foreground max-w-sm mx-auto text-lg">
            {hotel && !isPublished 
              ? "We are currently curating our masterpiece. Please check back soon for an exquisite dining experience."
              : (error || "The culinary destination you're looking for has moved.")}
          </p>
          <Button asChild size="lg" variant="outline" className="rounded-full px-8">
            <Link href="/">Return to Entrance</Link>
          </Button>
        </motion.div>
      </div>
    )
  }

  const coverImage = getImageUrl(
    hotel.cover_url ||
    (hotel as any).cover_image_url ||
    (hotel as any).cover_image ||
    (hotel as any).cover
  ) || "/hotel.webp"

  const logoImage = getImageUrl(
    hotel.logo_url ||
    (hotel as any).logo_image_url ||
    (hotel as any).logo_image ||
    (hotel as any).logo
  )

  const reservationEnabled = Boolean(
    hotel.enableReservation ??
    hotel.enable_reservation ??
    hotel.reservation_enabled
  )

  const events = useMemo(() => {
    const source = hotel.events || hotel.upcoming_events
    return Array.isArray(source) ? source : []
  }, [hotel.events, hotel.upcoming_events])

  const testimonials = useMemo<Testimonial[]>(() => {
    const source = hotel.testimonials
    if (Array.isArray(source) && source.length > 0) return source
    return [
      {
        name: "Selam T.",
        text: "Elegant ambiance, refined flavors, and impeccable service. This place feels like a destination.",
        rating: 5,
      },
      {
        name: "Meklit A.",
        text: "Every dish was thoughtfully crafted. The menu and experience feel truly premium.",
        rating: 5,
      },
      {
        name: "Daniel K.",
        text: "A beautiful space with unforgettable meals. We will be back for special occasions.",
        rating: 4,
      },
    ]
  }, [hotel.testimonials])

  const previewItems = useMemo<MenuPreviewItem[]>(() => {
    if (menuPreview.length > 0) return menuPreview
    const source = (hotel.popular_items || hotel.featured_items) as MenuPreviewItem[] | undefined
    return Array.isArray(source) ? source.slice(0, 5) : []
  }, [menuPreview, hotel.popular_items, hotel.featured_items])

  const bestDishes = useMemo<BestDish[]>(() => {
    if (previewItems.length > 0) {
      return previewItems.slice(0, 3).map((item, index) => ({
        id: item.id,
        name: item.name,
        description: item.description || "A signature creation loved by our guests.",
        price: item.price,
        currency: item.currency,
        image_url: item.image_url,
        rating: 4.8,
        tag: index === 0 ? "Chef's Pick" : "House Favorite",
      }))
    }

    return [
      {
        id: "signature-1",
        name: "Saffron Citrus Salmon",
        description: "Slow-roasted salmon with saffron glaze, citrus zest, and garden herbs.",
        price: 28,
        currency: "$",
        image_url: "/hotel.webp",
        rating: 4.9,
        tag: "Chef's Pick",
      },
      {
        id: "signature-2",
        name: "Golden Truffle Risotto",
        description: "Creamy arborio rice finished with truffle oil and aged parmesan.",
        price: 22,
        currency: "$",
        image_url: "/hotel.webp",
        rating: 4.8,
        tag: "House Favorite",
      },
      {
        id: "signature-3",
        name: "Heritage Spiced Lamb",
        description: "Tender lamb braised with seasonal spices and roasted vegetables.",
        price: 30,
        currency: "$",
        image_url: "/hotel.webp",
        rating: 4.7,
        tag: "Guest Choice",
      },
    ]
  }, [previewItems])

  const mapQuery = hotel.address ? encodeURIComponent(hotel.address) : ""
  const mapSrc = mapQuery ? `https://www.google.com/maps?q=${mapQuery}&output=embed` : ""
  const mapLink = mapQuery ? `https://www.google.com/maps/search/?api=1&query=${mapQuery}` : ""
  const menuLink = `/menu/${hotelSlug}/list`

  return (
    <div className="min-h-screen bg-background text-foreground">
      <main>
        <HeroSection
          hotel={hotel}
          coverImage={coverImage}
          logoImage={logoImage}
          menuLink={menuLink}
          mapLink={mapLink}
          reservationEnabled={reservationEnabled}
        />
        <StorySection hotel={hotel} coverImage={coverImage} />
        {(previewItems.length > 0 || menuLoading) && (
          <MenuPreviewSection
            items={previewItems}
            loading={menuLoading}
            menuLink={menuLink}
          />
        )}
        {(hotel.address || hotel.phone) && (
          <LocationSection hotel={hotel} mapSrc={mapSrc} mapLink={mapLink} />
        )}
        {reservationEnabled && (
          <ReservationSection hotel={hotel} />
        )}
        {events.length > 0 && (
          <EventsSection events={events} />
        )}
        <TestimonialsSection testimonials={testimonials} />
      </main>
      <FooterSection hotel={hotel} />
    </div>
  )
}

function HeroSection({
  hotel,
  coverImage,
  logoImage,
  menuLink,
  mapLink,
  reservationEnabled,
}: {
  hotel: Restaurant
  coverImage: string
  logoImage?: string | null
  menuLink: string
  mapLink: string
  reservationEnabled: boolean
}) {
  return (
    <section className="relative w-full overflow-hidden">
      <div className="absolute inset-0">
        <Image src={coverImage} alt={hotel.name} fill className="object-cover" priority />
        <div className="absolute inset-0 bg-black/60" />
        <div className="absolute inset-0 bg-linear-to-b from-black/30 via-black/70 to-black" />
      </div>

      <div className="relative z-10 container mx-auto px-6 pt-28 pb-24 md:pt-36 md:pb-32">
        <div className="max-w-5xl space-y-8">
          <div className="flex flex-wrap items-center gap-4">
            <Badge className="bg-white/10 text-white border border-white/20 rounded-full px-4 py-1">
              <Clock className="mr-2 h-3.5 w-3.5" />
              {hotel.opening_hours || "Open Daily 8:00 AM - 11:00 PM"}
            </Badge>
            <div className="flex items-center gap-2 rounded-full bg-white/10 px-4 py-1 text-white">
              <Star className="h-4 w-4 fill-yellow-400 text-yellow-400" />
              <span className="text-sm font-semibold">{hotel.rating ? `${hotel.rating}/5` : "4.8/5"}</span>
              <span className="text-xs text-white/70">(180+ reviews)</span>
            </div>
          </div>

          <div className="flex flex-wrap items-center gap-6">
            {logoImage ? (
              <div className="relative h-20 w-20 rounded-2xl bg-white/10 p-2 backdrop-blur-xl border border-white/20">
                <Image src={logoImage} alt={hotel.name} fill className="object-contain p-2" />
              </div>
            ) : null}
            <div>
              <p className="text-sm uppercase tracking-[0.4em] text-white/70">{hotel.cuisine_type || "Restaurant"}</p>
              <h1 className="text-4xl md:text-6xl font-semibold text-white leading-tight">{hotel.name}</h1>
            </div>
          </div>

          <p className="text-lg md:text-2xl text-white/80 max-w-2xl">
            {hotel.tagline || hotel.description || "A refined dining experience with a modern touch."}
          </p>

          <div className="flex flex-wrap gap-4">
            <Button size="lg" className="rounded-xl px-8 h-12 shadow-xl shadow-black/20" asChild>
              <Link href={menuLink}>View Menu</Link>
            </Button>
            {reservationEnabled && (
              <Button size="lg" variant="secondary" className="rounded-xl px-8 h-12" asChild>
                <Link href="#reservation">Reserve a Table</Link>
              </Button>
            )}
            {mapLink && (
              <Button size="lg" variant="outline" className="rounded-xl px-8 h-12 border-white/30 text-white hover:bg-white/10" asChild>
                <a href={mapLink} target="_blank" rel="noreferrer">
                  Get Directions <ExternalLink className="ml-2 h-4 w-4" />
                </a>
              </Button>
            )}
          </div>

          <div className="flex flex-wrap items-center gap-4 text-white/80">
            {hotel.address && (
              <div className="flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm">
                <MapPin className="h-4 w-4 text-primary" />
                <span>{hotel.address.split(",")[0]}</span>
              </div>
            )}
            {hotel.phone && (
              <div className="flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm">
                <Phone className="h-4 w-4 text-primary" />
                <span>{hotel.phone}</span>
              </div>
            )}
            {hotel.email && (
              <div className="flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm">
                <Mail className="h-4 w-4 text-primary" />
                <span>{hotel.email}</span>
              </div>
            )}
          </div>

          <SocialLinks hotel={hotel} variant="light" />
        </div>
      </div>
    </section>
  )
}

function StorySection({ hotel, coverImage }: { hotel: Restaurant; coverImage: string }) {
  return (
    <section id="story" className="py-20 md:py-28 bg-muted/30">
      <div className="container mx-auto px-6">
        <div className="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 items-center">
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            className="space-y-6"
          >
            <p className="text-sm uppercase tracking-[0.4em] text-muted-foreground">Our Story</p>
            <h2 className="text-3xl md:text-5xl font-semibold">Crafted for the modern diner</h2>
            <p className="text-lg text-muted-foreground leading-relaxed">
              {hotel.description ||
                "Rooted in hospitality and inspired by the energy of the city, we curate memorable moments with every plate, every pour, and every detail."}
            </p>
            <div className="grid sm:grid-cols-2 gap-4">
              <div className="rounded-2xl bg-card p-5 shadow-sm border border-border">
                <p className="text-sm uppercase tracking-[0.3em] text-muted-foreground">Cuisine</p>
                <p className="text-lg font-semibold">{hotel.cuisine_type || "Seasonal"}</p>
              </div>
              <div className="rounded-2xl bg-card p-5 shadow-sm border border-border">
                <p className="text-sm uppercase tracking-[0.3em] text-muted-foreground">Atmosphere</p>
                <p className="text-lg font-semibold">Warm, elegant, and vibrant</p>
              </div>
            </div>
          </motion.div>
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            className="relative h-90 md:h-115 rounded-4xl overflow-hidden shadow-2xl"
          >
            <Image src={coverImage} alt={`${hotel.name} story`} fill className="object-cover" />
            <div className="absolute inset-0 bg-linear-to-t from-black/30 via-transparent to-transparent" />
          </motion.div>
        </div>
      </div>
    </section>
  )
}

function BestDishesSection({ dishes }: { dishes: BestDish[] }) {
  if (dishes.length === 0) return null

  return (
    <section id="best-dishes" className="py-20 md:py-28 bg-background">
      <div className="container mx-auto px-6">
        <div className="flex items-end justify-between flex-wrap gap-6 mb-12">
          <div>
            <p className="text-sm uppercase tracking-[0.4em] text-muted-foreground">Best Dishes</p>
            <h2 className="text-3xl md:text-5xl font-semibold">Signature plates guests love</h2>
            <p className="text-muted-foreground mt-3 max-w-2xl">
              A curated selection of our most celebrated dishes, crafted to showcase our culinary identity.
            </p>
          </div>
        </div>
        <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {dishes.map((dish) => (
            <div key={dish.id} className="rounded-4xl border border-border bg-card overflow-hidden shadow-sm hover:shadow-md transition-shadow">
              <div className="relative h-48 w-full">
                <Image src={getImageUrl(dish.image_url) || "/hotel.webp"} alt={dish.name} fill className="object-cover" />
                <div className="absolute top-4 left-4 bg-white/90 text-foreground text-xs font-semibold px-3 py-1 rounded-full">
                  {dish.tag}
                </div>
              </div>
              <div className="p-6 space-y-4">
                <div className="flex items-start justify-between gap-4">
                  <div>
                    <h3 className="text-xl font-semibold">{dish.name}</h3>
                    <p className="text-sm text-muted-foreground">{dish.description}</p>
                  </div>
                  <span className="text-sm font-semibold text-primary">
                    {dish.currency || "$"} {Number(dish.price).toFixed(2)}
                  </span>
                </div>
                <div className="flex items-center gap-2 text-yellow-400">
                  <Star className="h-4 w-4 fill-yellow-400" />
                  <span className="text-sm text-foreground">{dish.rating.toFixed(1)} / 5</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

function LocationSection({
  hotel,
  mapSrc,
  mapLink,
}: {
  hotel: Restaurant
  mapSrc: string
  mapLink: string
}) {
  const whatsappLink = hotel.phone
    ? `https://wa.me/${hotel.phone.replace(/[^0-9]/g, "")}`
    : ""

  if (!hotel.address && !hotel.phone) return null

  return (
    <section id="location" className="py-20 md:py-28 bg-background">
      <div className="container mx-auto px-6">
        <div className="grid lg:grid-cols-[1fr_1.1fr] gap-12 items-center">
          <div className="space-y-6">
            <p className="text-sm uppercase tracking-[0.4em] text-muted-foreground">Location</p>
            <h2 className="text-3xl md:text-5xl font-semibold">Find us in the heart of the city</h2>
            {hotel.address && (
              <div className="flex items-start gap-3 text-muted-foreground">
                <MapPin className="h-5 w-5 text-primary mt-1" />
                <p className="text-base">{hotel.address}</p>
              </div>
            )}
            <div className="flex flex-wrap gap-4">
              {mapLink && (
                <Button size="lg" className="rounded-xl px-6" asChild>
                  <a href={mapLink} target="_blank" rel="noreferrer">
                    Open in Google Maps <ExternalLink className="ml-2 h-4 w-4" />
                  </a>
                </Button>
              )}
              {hotel.phone && (
                <Button size="lg" variant="outline" className="rounded-xl px-6" asChild>
                  <a href={`tel:${hotel.phone}`}>
                    <Phone className="mr-2 h-4 w-4" /> {hotel.phone}
                  </a>
                </Button>
              )}
              {whatsappLink && (
                <Button size="lg" variant="secondary" className="rounded-xl px-6" asChild>
                  <a href={whatsappLink} target="_blank" rel="noreferrer">
                    <MessageCircle className="mr-2 h-4 w-4" /> WhatsApp
                  </a>
                </Button>
              )}
              {hotel.website_url && (
                <Button size="lg" variant="outline" className="rounded-xl px-6" asChild>
                  <a href={hotel.website_url} target="_blank" rel="noreferrer">
                    <Globe className="mr-2 h-4 w-4" /> Website
                  </a>
                </Button>
              )}
            </div>
            <SocialLinks hotel={hotel} />
          </div>
          {mapSrc && (
            <div className="rounded-4xl overflow-hidden shadow-2xl border border-black/10">
              <iframe
                title="Restaurant location"
                src={mapSrc}
                className="w-full h-90 md:h-105"
                loading="lazy"
                referrerPolicy="no-referrer-when-downgrade"
              />
            </div>
          )}
        </div>
      </div>
    </section>
  )
}

function ReservationSection({ hotel }: { hotel: Restaurant }) {
  const [form, setForm] = useState({
    name: "",
    phone: "",
    guests: "",
    date: "",
    time: "",
  })
  const [errors, setErrors] = useState<Record<string, string>>({})
  const [success, setSuccess] = useState(false)

  const handleChange = (field: string, value: string) => {
    setForm((prev) => ({ ...prev, [field]: value }))
    setErrors((prev) => ({ ...prev, [field]: "" }))
  }

  const handleSubmit = (event: FormEvent) => {
    event.preventDefault()
    const nextErrors: Record<string, string> = {}

    if (!form.name.trim()) nextErrors.name = "Name is required"
    if (!form.phone.trim()) nextErrors.phone = "Phone is required"
    if (!form.guests.trim()) nextErrors.guests = "Guests is required"
    if (!form.date.trim()) nextErrors.date = "Date is required"
    if (!form.time.trim()) nextErrors.time = "Time is required"

    if (Object.keys(nextErrors).length > 0) {
      setErrors(nextErrors)
      return
    }

    setSuccess(true)
    setForm({ name: "", phone: "", guests: "", date: "", time: "" })
  }

  return (
    <section id="reservation" className="py-20 md:py-28 bg-muted/30">
      <div className="container mx-auto px-6">
        <div className="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 items-start">
          <div className="space-y-6">
            <p className="text-sm uppercase tracking-[0.4em] text-muted-foreground">Table Reservation</p>
            <h2 className="text-3xl md:text-5xl font-semibold">Reserve your table in minutes</h2>
            <p className="text-lg text-muted-foreground">
              Share the details below and our team will confirm the reservation promptly.
            </p>
            <div className="rounded-2xl bg-card p-6 shadow-sm border border-border space-y-3">
              <p className="text-sm uppercase tracking-[0.3em] text-muted-foreground">Contact</p>
              <div className="flex items-center gap-3 text-muted-foreground">
                <Phone className="h-4 w-4" /> {hotel.phone || "Call us for direct assistance"}
              </div>
            </div>
          </div>
          <form onSubmit={handleSubmit} className="space-y-4 rounded-4xl bg-card p-8 shadow-xl border border-border">
            <div className="grid gap-2">
              <Label htmlFor="name">Name</Label>
              <Input
                id="name"
                value={form.name}
                onChange={(e) => handleChange("name", e.target.value)}
                className={cn(errors.name && "border-destructive")}
                placeholder="Your full name"
              />
              {errors.name && <p className="text-xs text-destructive">{errors.name}</p>}
            </div>
            <div className="grid gap-2">
              <Label htmlFor="phone">Phone</Label>
              <Input
                id="phone"
                value={form.phone}
                onChange={(e) => handleChange("phone", e.target.value)}
                className={cn(errors.phone && "border-destructive")}
                placeholder="+251 900 000 000"
              />
              {errors.phone && <p className="text-xs text-destructive">{errors.phone}</p>}
            </div>
            <div className="grid gap-2">
              <Label htmlFor="guests">Number of guests</Label>
              <Input
                id="guests"
                type="number"
                min={1}
                value={form.guests}
                onChange={(e) => handleChange("guests", e.target.value)}
                className={cn(errors.guests && "border-destructive")}
                placeholder="2"
              />
              {errors.guests && <p className="text-xs text-destructive">{errors.guests}</p>}
            </div>
            <div className="grid sm:grid-cols-2 gap-4">
              <div className="grid gap-2">
                <Label htmlFor="date">Date</Label>
                <Input
                  id="date"
                  type="date"
                  value={form.date}
                  onChange={(e) => handleChange("date", e.target.value)}
                  className={cn(errors.date && "border-destructive")}
                />
                {errors.date && <p className="text-xs text-destructive">{errors.date}</p>}
              </div>
              <div className="grid gap-2">
                <Label htmlFor="time">Time</Label>
                <Input
                  id="time"
                  type="time"
                  value={form.time}
                  onChange={(e) => handleChange("time", e.target.value)}
                  className={cn(errors.time && "border-destructive")}
                />
                {errors.time && <p className="text-xs text-destructive">{errors.time}</p>}
              </div>
            </div>
            <Button type="submit" size="lg" className="w-full rounded-xl h-12">Submit Reservation</Button>
            {success && (
              <div className="rounded-xl bg-emerald-50 text-emerald-700 px-4 py-3 text-sm">
                Reservation request sent. We will confirm shortly.
              </div>
            )}
          </form>
        </div>
      </div>
    </section>
  )
}

function EventsSection({ events }: { events: EventItem[] }) {
  return (
    <section id="events" className="py-20 md:py-28 bg-background">
      <div className="container mx-auto px-6">
        <div className="flex items-end justify-between flex-wrap gap-6 mb-12">
          <div>
            <p className="text-sm uppercase tracking-[0.4em] text-muted-foreground">Upcoming Events</p>
            <h2 className="text-3xl md:text-5xl font-semibold">Plan your next night out</h2>
          </div>
        </div>
        <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {events.map((event) => (
            <div key={event.id || event.title} className="rounded-4xl border border-border bg-card overflow-hidden shadow-sm hover:shadow-md transition-shadow">
              <div className="relative h-44 w-full">
                <Image
                  src={getImageUrl(event.image_url) || "/hotel.webp"}
                  alt={event.title}
                  fill
                  className="object-cover"
                />
              </div>
              <div className="p-6 space-y-3">
                <div className="flex items-center gap-2 text-sm text-muted-foreground">
                  <Calendar className="h-4 w-4" /> {event.date}
                </div>
                <h3 className="text-xl font-semibold">{event.title}</h3>
                <p className="text-sm text-muted-foreground">{event.description || "Join us for a curated culinary experience."}</p>
                {event.href && (
                  <Button variant="outline" className="rounded-xl" asChild>
                    <a href={event.href} target="_blank" rel="noreferrer">
                      Learn More
                    </a>
                  </Button>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

function MenuPreviewSection({
  items,
  loading,
  menuLink,
}: {
  items: MenuPreviewItem[]
  loading: boolean
  menuLink: string
}) {
  return (
    <section id="menu" className="py-20 md:py-28 bg-muted/30">
      <div className="container mx-auto px-6">
        <div className="flex items-end justify-between flex-wrap gap-6 mb-12">
          <div>
            <p className="text-sm uppercase tracking-[0.4em] text-muted-foreground">Menu Preview</p>
            <h2 className="text-3xl md:text-5xl font-semibold">Popular picks from our menu</h2>
          </div>
          <Button className="rounded-xl" asChild>
            <Link href={menuLink}>Explore Full Menu</Link>
          </Button>
        </div>
        {loading ? (
          <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {[1, 2, 3].map((i) => (
              <div key={i} className="h-48 rounded-4xl bg-card border border-border animate-pulse" />
            ))}
          </div>
        ) : (
          <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {items.map((item) => (
              <div key={item.id} className="rounded-4xl border border-border bg-card p-6 shadow-sm hover:shadow-md transition-shadow">
                <div className="flex items-start justify-between gap-4">
                  <div>
                    <h3 className="text-xl font-semibold">{item.name}</h3>
                    <p className="text-sm text-muted-foreground line-clamp-2">{item.description}</p>
                  </div>
                  <span className="text-sm font-semibold text-primary">
                    {item.currency || "$"} {Number(item.price).toFixed(2)}
                  </span>
                </div>
                {item.image_url && (
                  <div className="relative mt-4 h-32 w-full rounded-xl overflow-hidden">
                    <Image src={getImageUrl(item.image_url) || "/hotel.webp"} alt={item.name} fill className="object-cover" />
                  </div>
                )}
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}

function TestimonialsSection({ testimonials }: { testimonials: Testimonial[] }) {
  return (
    <section className="py-20 md:py-28 bg-background">
      <div className="container mx-auto px-6">
        <div className="text-center max-w-2xl mx-auto mb-12 space-y-4">
          <div className="flex justify-center gap-1 text-yellow-400">
            {[...Array(5)].map((_, i) => (
              <Star key={i} className="h-4 w-4 fill-yellow-400" />
            ))}
          </div>
          <h2 className="text-3xl md:text-5xl font-semibold">Guests love the experience</h2>
          <p className="text-muted-foreground">Thoughts from people who know the menu best.</p>
        </div>
        <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {testimonials.map((review) => (
            <div key={review.name} className="rounded-4xl bg-card p-6 border border-border shadow-sm">
              <div className="flex items-center gap-2 text-yellow-400 mb-4">
                {[...Array(review.rating || 5)].map((_, i) => (
                  <Star key={i} className="h-4 w-4 fill-yellow-400" />
                ))}
              </div>
              <p className="text-base text-muted-foreground">"{review.text}"</p>
              <p className="mt-4 text-sm font-semibold">{review.name}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

function FooterSection({ hotel }: { hotel: Restaurant }) {
  return (
    <footer className="bg-foreground text-background py-16">
      <div className="container mx-auto px-6 grid md:grid-cols-3 gap-10">
        <div className="space-y-4">
          <Logo width={140} height={40} />
          <p className="text-sm text-white/70">
            Premium digital menus for modern hospitality.
          </p>
        </div>
        <div className="space-y-3">
          <p className="text-xs uppercase tracking-[0.3em] text-white/50">Contact</p>
          {hotel.address && <p className="text-sm text-white/70">{hotel.address}</p>}
          {hotel.phone && <p className="text-sm text-white/70">{hotel.phone}</p>}
          {hotel.email && <p className="text-sm text-white/70">{hotel.email}</p>}
        </div>
        <div className="space-y-3">
          <p className="text-xs uppercase tracking-[0.3em] text-white/50">Social</p>
          <SocialLinks hotel={hotel} variant="light" />
        </div>
      </div>
      <div className="container mx-auto px-6 pt-10 mt-10 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4">
        <p className="text-xs text-white/50">Copyright {new Date().getFullYear()} {hotel.name}. All rights reserved.</p>
        <p className="text-xs text-white/50">Powered by Agelgil</p>
      </div>
    </footer>
  )
}

function SocialLinks({
  hotel,
  variant,
}: {
  hotel: Restaurant
  variant?: "light" | "dark"
}) {
  const baseClass =
    variant === "light"
      ? "border-white/30 text-white hover:bg-white/10"
      : "border-border text-foreground hover:bg-muted"

  return (
    <div className="flex flex-wrap items-center gap-3">
      {hotel.instagram_url && (
        <a
          href={hotel.instagram_url}
          target="_blank"
          rel="noreferrer"
          className={cn("h-10 w-10 rounded-full border flex items-center justify-center transition-colors", baseClass)}
        >
          <Instagram className="h-4 w-4" />
        </a>
      )}
      {hotel.facebook_url && (
        <a
          href={hotel.facebook_url}
          target="_blank"
          rel="noreferrer"
          className={cn("h-10 w-10 rounded-full border flex items-center justify-center transition-colors", baseClass)}
        >
          <Facebook className="h-4 w-4" />
        </a>
      )}
      {hotel.twitter_url && (
        <a
          href={hotel.twitter_url}
          target="_blank"
          rel="noreferrer"
          className={cn("h-10 w-10 rounded-full border flex items-center justify-center transition-colors", baseClass)}
        >
          <Twitter className="h-4 w-4" />
        </a>
      )}
      {hotel.tiktok_url && (
        <a
          href={hotel.tiktok_url}
          target="_blank"
          rel="noreferrer"
          className={cn("h-10 w-10 rounded-full border flex items-center justify-center transition-colors", baseClass)}
        >
          <svg viewBox="0 0 24 24" fill="currentColor" className="h-4 w-4">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.04-.1z" />
          </svg>
        </a>
      )}
      {hotel.website_url && (
        <a
          href={hotel.website_url}
          target="_blank"
          rel="noreferrer"
          className={cn("h-10 w-10 rounded-full border flex items-center justify-center transition-colors", baseClass)}
        >
          <Globe className="h-4 w-4" />
        </a>
      )}
      {hotel.email && (
        <a
          href={`mailto:${hotel.email}`}
          className={cn("h-10 w-10 rounded-full border flex items-center justify-center transition-colors", baseClass)}
        >
          <Mail className="h-4 w-4" />
        </a>
      )}
    </div>
  )
}

